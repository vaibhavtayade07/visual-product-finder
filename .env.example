# Copy to .env and adjust. Mock mode needs none of the provider keys.

# --- Core ---
APP_MODE=mock                     # mock | prod  (mock = deterministic providers, keyless)
DATABASE_URL=postgresql://finder:finder@localhost:5433/finder
TEST_DATABASE_URL=postgresql://finder:finder@localhost:5433/finder_test
PUBLIC_BASE_URL=http://127.0.0.1:8000
DEFAULT_TENANT_SLUG=demo
ADMIN_TOKEN=dev-admin-token
LOG_LEVEL=INFO
RUN_MIGRATIONS_ON_START=1
WORKERS_ENABLED=1
SCHEDULER_ENABLED=1
STORAGE_BACKEND=local             # local | r2

# --- Providers (real mode only; mock mode ignores) ---
EMBEDDING_PROVIDER=local_clip     # auto | mock | local_clip | vertex | titan
VISION_PROVIDER=auto              # auto | mock | gemini | openai
RERANK_MODE=vision                # vision | text_only
EMBEDDING_MODEL=multimodalembedding@001

# --- Local CLIP (EMBEDDING_PROVIDER=local_clip): keyless, CPU-only, offline after
# --- the first download (~340 MB). Re-seed the catalog after switching providers so
# --- all vectors share one space; `model` filtering prevents cross-space retrieval.
LOCAL_CLIP_MODEL=Qdrant/clip-ViT-B-32-vision
LOCAL_CLIP_THREADS=4
# LOCAL_CLIP_CACHE_DIR=            # default: <DATA_DIR>/models
GCP_PROJECT_ID=
GCP_SA_JSON=                      # path to service-account json OR raw json
VERTEX_LOCATION=us-central1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AWS_REGION=us-east-1              # for Titan fallback embedding

# --- Cloudflare R2 (STORAGE_BACKEND=r2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# --- Tunables / test hooks ---
QUERY_CAP_MONTHLY=10000
RETENTION_DAYS=30
MOCK_LLM_DELAY_S=0                # mock-mode only: simulate slow vision LLM (E10 tests)
MOCK_QUERY_CATEGORY=              # mock-mode only: force extracted category (E6 tests)
MOCK_QUERY_CONFIDENCE=            # mock-mode only: force category confidence
CORS_ORIGINS=                     # comma-separated; empty = same-origin only

# --- Shopify catalog (optional; mock/CSV stay the default) ---
# SHOPIFY_SHOP_DOMAIN looks like your-store.myshopify.com
SHOPIFY_SHOP_DOMAIN=
# Admin API access token with read_products + read_inventory scopes
SHOPIFY_ADMIN_TOKEN=
# Pinned stable Admin GraphQL version
SHOPIFY_API_VERSION=2026-07